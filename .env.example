# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# REDMINE_URL: URL of your Redmine instance (e.g., https://redmine.anybim.vn)
REDMINE_URL="https://redmine.anybim.vn"

# REDMINE_API_KEY: User API Access Key found at /my/account in Redmine
REDMINE_API_KEY="440da87a37415860ff240080d18ba34b21536eb8"

# GOOGLE SERVICE ACCOUNT (Tùy chọn: Đồng bộ 2 chiều Google Sheets tự động không cần Apps Script)
# Bạn có thể dùng file google-service-account.json ở thư mục gốc HOẶC cấu hình 2 biến dưới:
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_PROJECT_ID="your-project-id"
